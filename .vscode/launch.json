{
  // Run from the Run and Debug panel (Ctrl+Shift+D). Needs `cd backend; uv sync` once.
  // Everything goes through python.exe: Smart App Control blocks the .exe launchers in .venv\Scripts.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SVS explorer (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "apps/svs_explorer.py"],
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    },
    {
      "name": "Tests (backend)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    },
    {
      "name": "PoC 1: render global WAV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/poc1_render_global.py",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    },
    {
      "name": "PoC 2: export tracks.json",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/poc2_export_tracks.py",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    },
    {
      "name": "Arcade web server (:8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "http.server",
      "args": ["8000"],
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/frontend/arcade",
      "justMyCode": true
    },
    {
      "name": "Player web server (:8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "http.server",
      "args": ["8001"],
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/frontend/player",
      "justMyCode": true
    },
    {
      "name": "Current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    }
  ]
}
